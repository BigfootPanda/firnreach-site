---
import Site from '../../layouts/Site.astro';
import news from '../../data/news.json';

export function getStaticPaths() {
	return news.map((n, i) => ({
		params: { slug: n.slug },
		props: { post: n, newer: news[i - 1], older: news[i + 1] },
	}));
}
const { post, newer, older } = Astro.props;
// Meta/OG description: the version and title plus the first patch-note line, so shared links preview what changed.
const lead = post.items[0] ?? '';
const summary = `Firnreach v${post.version} patch notes: ${post.title}. ${lead}`;
const description = summary.length > 160 ? `${summary.slice(0, 157).replace(/\s+\S*$/, '')}...` : summary;
---

<Site title={`v${post.version}: ${post.title}`} description={description}>
	<div class="wrap">
		<header class="page-head">
			<p class="eyebrow"><a href="/news/">News</a> &middot; v{post.version} &middot; {post.date}</p>
			<h1>{post.title}</h1>
		</header>
		<div class="prose">
			<ul>
				{post.items.map((i) => <li>{i}</li>)}
			</ul>
		</div>
		<nav class="pager" aria-label="More updates">
			{older ? <a class="btn" href={`/news/${older.slug}/`}>&larr; v{older.version}</a> : <span />}
			{newer && <a class="btn" href={`/news/${newer.slug}/`}>v{newer.version} &rarr;</a>}
		</nav>
	</div>
</Site>

<style>
	.pager {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		margin: 40px 0 64px;
	}
</style>
