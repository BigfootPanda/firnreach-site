---
// A plain chat-bubble glyph drawn for the site (not Discord's logo). Decorative: the link text carries the meaning.
interface Props {
	size?: number;
}
const { size = 20 } = Astro.props;
---

<svg class="fr-chat-icon" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
	<path
		fill="currentColor"
		fill-rule="evenodd"
		d="M5 3h14a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3h-6.6l-4.7 3.6A1 1 0 0 1 6 20.8V18H5a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Zm3.5 6.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm7 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"
	/>
</svg>
