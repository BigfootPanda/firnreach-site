---
// Layout for the marketing pages (home, news, FAQ). The wiki uses Starlight's own layout with the same tokens.
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/600.css';
import '../styles/tokens.css';
import '../styles/site.css';
import { NAV, SITE } from '../site';
import DiscordIcon from '../components/DiscordIcon.astro';

interface Props {
	title?: string;
	description?: string;
}
const { title, description = SITE.description } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site ?? Astro.url).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#060c16" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<header class="top">
			<div class="top-inner">
				<a class="wordmark" href="/" aria-label="Firnreach home">FIRNREACH</a>
				<nav aria-label="Site">
					{
						NAV.map(({ href, label }) => (
							<a href={href} class={href === '/' ? 'nav-home' : undefined} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>
								{label}
							</a>
						))
					}
				</nav>
				<a class="btn discord top-discord" href={SITE.discordUrl} rel="noopener" aria-label="Join the Firnreach Discord">
					<DiscordIcon size={18} />
					<span class="discord-label">Discord</span>
				</a>
			</div>
		</header>
		<main id="main">
			<slot />
		</main>
		<footer class="foot">
			<div class="foot-inner">
				<span class="wordmark small">FIRNREACH</span>
				<span>Survival tower defense for 1 to 8 players.</span>
				<a class="foot-discord" href={SITE.discordUrl} rel="noopener">
					<DiscordIcon size={18} />
					Join the Discord
				</a>
				<span class="muted">&copy; {year} Firnreach. All rights reserved.</span>
			</div>
		</footer>
	</body>
</html>
