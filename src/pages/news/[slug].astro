---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Site from '../../layouts/Site.astro';
import news from '../../data/news.json';

export function getStaticPaths() {
	return news.map((n, i) => ({
		params: { slug: n.slug },
		props: { post: n, newer: news[i - 1], older: news[i + 1] },
	}));
}
const { post, newer, older } = Astro.props;
// Meta/OG description: the version and title plus the first patch-note line, so shared links preview what changed.
const lead = post.items[0] ?? '';
const summary = `Firnreach v${post.version} patch notes: ${post.title}. ${lead}`;
const description = summary.length > 160 ? `${summary.slice(0, 157).replace(/\s+\S*$/, '')}...` : summary;

// Patch-note pictures: scripts/export-game-data.mjs copies them to src/assets/news/<slug>/ and lists them in
// news.json as images: [{ src: '<slug>/<file>', caption }]. The caption is also the alt text.
const pictureFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/news/*/*.{png,jpg,jpeg,webp}', { eager: true });
const postImages: { caption: string; src?: string }[] = (post as { images?: { caption: string; src?: string }[] }).images ?? [];
const pictures = postImages
	.map((p) => ({ caption: p.caption, img: pictureFiles[`../../assets/news/${p.src}`]?.default }))
	.filter((p): p is { caption: string; img: ImageMetadata } => !!p.img);
---

<Site title={`v${post.version}: ${post.title}`} description={description}>
	<div class="wrap">
		<header class="page-head">
			<p class="eyebrow"><a href="/news/">News</a> &middot; v{post.version} &middot; {post.date}</p>
			<h1>{post.title}</h1>
		</header>
		<div class="prose">
			<ul>
				{post.items.map((i) => <li>{i}</li>)}
			</ul>
		</div>
		{
			pictures.length > 0 && (
				<section class="shots" aria-label="Pictures from this update">
					{pictures.map((p) => (
						<figure>
							<a class="shot" href={p.img.src} data-caption={p.caption}>
								<Image
									src={p.img}
									alt={p.caption}
									widths={[480, 800, Math.min(p.img.width, 1600)]}
									sizes="(min-width: 720px) 520px, calc(100vw - 32px)"
								/>
							</a>
							<figcaption>{p.caption}</figcaption>
						</figure>
					))}
				</section>
				<dialog class="lightbox" aria-label="Picture, full size">
					<button class="close" type="button" aria-label="Close">&times;</button>
					<img alt="" />
					<p class="lb-caption" />
				</dialog>
				<script is:inline>
					// Click a picture to see it full size (without JS the link opens the full-size file).
					(() => {
						const box = document.querySelector('dialog.lightbox');
						if (!box || typeof box.showModal !== 'function') return;
						const img = box.querySelector('img');
						const cap = box.querySelector('.lb-caption');
						document.querySelectorAll('a.shot').forEach((a) =>
							a.addEventListener('click', (e) => {
								e.preventDefault();
								img.src = a.href;
								img.alt = a.dataset.caption || '';
								cap.textContent = a.dataset.caption || '';
								box.showModal();
							}),
						);
						box.addEventListener('click', () => box.close());
						box.addEventListener('close', () => img.removeAttribute('src'));
					})();
				</script>
			)
		}
		<nav class="pager" aria-label="More updates">
			{older ? <a class="btn" href={`/news/${older.slug}/`}>&larr; v{older.version}</a> : <span />}
			{newer && <a class="btn" href={`/news/${newer.slug}/`}>v{newer.version} &rarr;</a>}
		</nav>
	</div>
</Site>

<style>
	.pager {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		margin: 40px 0 64px;
	}
	.shots {
		display: grid;
		grid-template-columns: 1fr;
		gap: 20px;
		margin-top: 32px;
	}
	@media (min-width: 720px) {
		.shots {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 24px;
		}
	}
	.shots figure {
		margin: 0;
	}
	.shot {
		display: block;
		border: 1px solid var(--fr-hairline);
		background: var(--fr-inset);
		cursor: zoom-in;
	}
	.shot:hover,
	.shot:focus-visible {
		border-color: var(--fr-rim);
	}
	.shot img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}
	.shots figcaption {
		margin-top: 8px;
		font-size: 0.95rem;
		line-height: 1.45;
		color: var(--fr-text-muted);
	}
	.lightbox {
		max-width: min(96vw, 1600px);
		max-height: 96vh;
		padding: 0;
		border: 1px solid var(--fr-rim);
		background: var(--fr-abyss);
		color: var(--fr-text);
		cursor: zoom-out;
	}
	.lightbox::backdrop {
		background: rgb(6 12 22 / 0.88);
	}
	.lightbox img {
		display: block;
		max-width: 100%;
		max-height: calc(96vh - 4rem);
		margin: 0 auto;
	}
	.lb-caption {
		margin: 0;
		padding: 10px 14px;
		font-size: 0.95rem;
	}
	.close {
		position: absolute;
		top: 6px;
		right: 8px;
		width: 40px;
		height: 40px;
		font-size: 1.8rem;
		line-height: 1;
		color: var(--fr-text);
		background: rgb(6 12 22 / 0.6);
		border: 1px solid var(--fr-hairline);
		cursor: pointer;
	}
</style>
