---
// Starlight SocialIcons override: the site-wide nav (Home / Wiki / News / FAQ) in the wiki header.
import { NAV, SITE } from '../site';
import DiscordIcon from './DiscordIcon.astro';
const path = Astro.url.pathname;
---

<nav class="fr-nav-links" aria-label="Site">
	{
		NAV.map(({ href, label }) => (
			<a href={href} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>
				{label}
			</a>
		))
	}
	<a class="fr-nav-discord" href={SITE.discordUrl} rel="noopener" aria-label="Join the Firnreach Discord" title="Join the Discord">
		<DiscordIcon size={20} />
	</a>
</nav>
