{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "firnreach-site",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-01",
	// PRIVATE until the Steam page is live: Cloudflare Access protects only the firnreach.com / firnreach.dev
	// hostnames. The *.workers.dev URL and preview URLs are NOT behind Access, so they stay off.
	"workers_dev": false,
	"preview_urls": false,
	// Custom domains (firnreach.com, www.firnreach.com, firnreach.dev) are attached separately by the lead
	// once Access is confirmed - see README "Deploy".
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// The worker runs first so it can redirect firnreach.dev and www before any asset is served.
		"run_worker_first": true,
		"not_found_handling": "404-page"
	},
	"observability": { "enabled": true }
}
