{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "firnreach-site",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-01",
	// PRIVATE until the Steam page is live: Cloudflare Access protects only the firnreach.com / firnreach.dev
	// hostnames. The *.workers.dev URL and preview URLs are NOT behind Access, so they stay off.
	"workers_dev": false,
	"preview_urls": false,
	// Custom domains (Alex said go 2026-10-08). All are behind the Access app "Firnreach site (private)".
	"routes": [
		{ "pattern": "firnreach.com", "custom_domain": true },
		{ "pattern": "www.firnreach.com", "custom_domain": true },
		{ "pattern": "firnreach.dev", "custom_domain": true },
		{ "pattern": "www.firnreach.dev", "custom_domain": true }
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// The worker runs first so it can redirect firnreach.dev and www before any asset is served.
		"run_worker_first": true,
		"not_found_handling": "404-page"
	},
	"observability": { "enabled": true }
}
